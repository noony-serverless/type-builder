{
  "name": "@noony-serverless/type-builder_monorepo",
  "version": "1.1.0",
  "description": "Ultra-fast TypeScript builder library with auto-detection for Zod, Classes, and Interfaces",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "packageManager": "pnpm@10.18.3",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "benchmark": "turbo run benchmark",
    "clinic": "turbo run clinic",
    "html:test": "cd packages/clinic-tests && npm run serve",
    "clinic:doctor": "cd packages/clinic-tests && npm run clinic:doctor",
    "clinic:flame": "cd packages/clinic-tests && npm run clinic:flame",
    "clinic:bubbleprof": "cd packages/clinic-tests && npm run clinic:bubbleprof",
    "clinic:heapprofiler": "cd packages/clinic-tests && npm run clinic:heapprofiler",
    "dev": "turbo run dev",
    "lint": "eslint \"packages/**/src/**/*.{ts,tsx}\" --max-warnings 0",
    "lint:fix": "eslint \"packages/**/src/**/*.{ts,tsx}\" --fix",
    "format": "prettier --write \"packages/**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"packages/**/*.{ts,tsx,json,md}\"",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.46.1",
    "@typescript-eslint/parser": "^8.46.1",
    "clinic": "^13.0.0",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "prettier": "^3.6.2",
    "turbo": "^2.5.8",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "pnpm": {
    "overrides": {
      "@babel/plugin-transform-modules-systemjs": "^7.29.4",
      "0x>ajv": "^8.18.0",
      "bn.js": "^4.12.3 || ^5.2.3",
      "brace-expansion": "^1.1.13 || ^2.0.3",
      "d3-color": "^3.1.0",
      "dompurify": "^3.4.0",
      "esbuild": "^0.25.0",
      "fast-uri": "^3.1.2",
      "flatted": "^3.4.2",
      "follow-redirects": "^1.16.0",
      "form-data": "^2.5.4 || ^4.0.5",
      "glob": "^10.5.0",
      "got": "^11.8.5 || ^15.0.5",
      "@eslint/eslintrc>js-yaml": "^4.1.1",
      "gray-matter>js-yaml": "^3.14.2",
      "lodash": "^4.17.23",
      "lodash-es": "^4.17.23",
      "mdast-util-to-hast": "^13.2.1",
      "mermaid": "^11.15.0",
      "minimatch": "^3.1.4 || ^9.0.7",
      "node-forge": "^1.4.0",
      "express>path-to-regexp": "^0.1.13",
      "picomatch": "^2.3.2 || ^4.0.4",
      "postcss": "^8.5.10",
      "protocol-buffers-schema": "^3.6.1",
      "qs": "^6.14.2",
      "request": "npm:@cypress/request@^3.0.8",
      "rollup": "^4.59.0",
      "serialize-javascript": "^7.0.5",
      "svgo": "^3.3.3",
      "tmp": "^0.2.5",
      "tough-cookie": "^4.1.3 || ^6.0.1",
      "uuid": "^11.1.1",
      "vite": "^6.4.2 || ^7.1.12 || ^8.0.13",
      "webpack": "^5.106.2",
      "webpack-dev-server": "^5.2.4",
      "ws": "^7.5.10 || ^8.20.1",
      "yaml": "^2.8.3",
      "zod": "^4.4.3"
    }
  }
}
